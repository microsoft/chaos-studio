{
  "$comment": "TEMPLATE ONLY — not evidence. Copy this file, run RV1-RV3 against the target preview environment per docs/runbooks/release-validation.md, replace every placeholder with what you OBSERVED, set template to false, then stamp and verify with: node scripts/lib/rv-receipt.mjs stamp <file> && node scripts/lib/rv-receipt.mjs verify <file>. The validator rejects this file as-is (template: true, checks not-run), so a checked-in receipt can never satisfy the release gate.",
  "schemaVersion": 1,
  "kind": "chaos-studio-release-validation-receipt",
  "template": true,
  "apiVersion": "2026-05-01-preview",
  "coreCommit": "<40-character commit SHA of the released microsoft/chaos-studio commit>",
  "generatedAt": "<ISO-8601 instant when the receipt was assembled>",
  "environment": {
    "cloud": "AzureCloud",
    "region": "<target preview region>",
    "workspaceScopeHash": "<sha256 hex of the target workspace resource ID>"
  },
  "artifacts": [
    {
      "platform": "github-action",
      "build": "<private Action build ref used for the run>",
      "coreCommit": "<same 40-character commit SHA>"
    },
    {
      "platform": "azure-pipelines-task",
      "build": "<ChaosStudioWorkspacesDev VSIX version used for the run>",
      "coreCommit": "<same 40-character commit SHA>"
    }
  ],
  "checks": [
