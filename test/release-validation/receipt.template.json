            "platform": "github-action",
            "validate": {
              "acceptedStatus": 0,
              "locationSuffix": "<trailing Location segments>",
              "retryAfterSeconds": 0,
              "terminalStatus": 0,
              "terminalState": "<observed properties.status>"
            },
            "$comment_runs": "successRun and cancellationRun.execute MUST be TWO SEPARATE runs: cancelling an already-terminal (Succeeded) run is a no-op (RV3), so the same run can never be observed both Succeeded and, independently, Canceled.",
            "successRun": {
              "acceptedStatus": 0,
              "locationSuffix": "<trailing Location segments>",
              "retryAfterSeconds": 0,
              "terminalStatus": 0,
              "terminalState": "<observed properties.status, must be Succeeded>",
              "runId": "<run GUID from the execute Location>",
              "runResourceIdSuffix": "<runs/{runId}>"
            },
            "cancellationRun": {
              "execute": {
                "acceptedStatus": 0,
                "locationSuffix": "<trailing Location segments>",
                "retryAfterSeconds": 0,
                "terminalStatus": 0,
                "terminalState": "<observed properties.status before cancel>",
                "runId": "<a DIFFERENT run GUID from successRun>",
                "runResourceIdSuffix": "<runs/{runId}>"
              },
              "cancel": {
                "acceptedStatus": 0,
                "locationSuffix": "<trailing Location segments>",
                "retryAfterSeconds": 0,
                "terminalStatus": 0,
                "terminalState": "<observed properties.status, must be Canceled>"
              }
            },
            "wire": {
              "statusField": "<status field name on the returned resources>",
              "startTimeField": "<start time field name>",
              "endTimeField": "<end time field name>",
              "validationErrorChannels": [],
              "runErrorChannels": []
            }
          },
          {
            "platform": "azure-pipelines-task",
            "validate": {
              "acceptedStatus": 0,
              "locationSuffix": "<trailing Location segments>",
              "retryAfterSeconds": 0,
              "terminalStatus": 0,
              "terminalState": "<observed properties.status>"
            },
            "successRun": {
              "acceptedStatus": 0,
              "locationSuffix": "<trailing Location segments>",
              "retryAfterSeconds": 0,
              "terminalStatus": 0,
              "terminalState": "<observed properties.status, must be Succeeded>",
              "runId": "<run GUID from the execute Location>",
              "runResourceIdSuffix": "<runs/{runId}>"
            },
            "cancellationRun": {
              "execute": {
                "acceptedStatus": 0,
                "locationSuffix": "<trailing Location segments>",
                "retryAfterSeconds": 0,
                "terminalStatus": 0,
                "terminalState": "<observed properties.status before cancel>",
                "runId": "<a DIFFERENT run GUID from successRun>",
                "runResourceIdSuffix": "<runs/{runId}>"
              },
              "cancel": {
                "acceptedStatus": 0,
                "locationSuffix": "<trailing Location segments>",
                "retryAfterSeconds": 0,
                "terminalStatus": 0,
                "terminalState": "<observed properties.status, must be Canceled>"
              }
            },
            "wire": {
              "statusField": "<status field name on the returned resources>",
              "startTimeField": "<start time field name>",
              "endTimeField": "<end time field name>",
              "validationErrorChannels": [],
              "runErrorChannels": []
            }
          }
        ]
      }
    },
    {
      "id": "RV2",
      "status": "not-run",
      "observedAt": "<ISO-8601 instant>",
      "observations": {
        "assignmentScope": "workspace",
        "roleDefinition": {
          "$comment": "The role definition the CI identity actually held during the run.",
          "Actions": []
