{
  "manifestVersion": 1,
  "id": "ChaosStudioWorkspaces",
  "publisher": "AzureChaosStudio",
  "version": "1.0.0",
  "name": "Azure Chaos Studio Workspaces",
  "description": "Validate and run Azure Chaos Studio v2 scenario configurations from Azure Pipelines with workload identity.",
  "public": true,
  "icons": {
    "default": "images/icon.png"
  },
  "content": {
    "details": {
      "path": "overview.md"
    }
  },
  "galleryFlags": [
    "Preview"
  ],
  "categories": [
    "Azure Pipelines"
  ],
  "targets": [
    {
      "id": "Microsoft.VisualStudio.Services"
    }
  ],
  "tags": [
    "Azure",
    "Chaos Studio",
    "Resilience",
    "Chaos Engineering",
    "Reliability"
  ],
  "files": [
    {
      "path": "tasks/AzureChaosStudioScenarioV1"
    },
    {
      "path": "overview.md",
      "addressable": true
    },
    {
      "path": "images/icon.png",
      "addressable": true
    }
  ],
  "contributions": [
    {
      "id": "AzureChaosStudioScenario",
      "type": "ms.vss-distributed-task.task",
      "targets": [
        "ms.vss-distributed-task.tasks"
      ],
      "properties": {
        "name": "tasks/AzureChaosStudioScenarioV1"
      }
    }
  ]
}
